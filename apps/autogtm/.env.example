# Supabase — Settings → API Keys
# New projects issue publishable/secret keys (sb_publishable_... / sb_secret_...).
# Legacy JWT names (anon / service_role) still work. The app accepts both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Exa API (https://exa.ai)
EXA_API_KEY=

# Instantly API (https://instantly.ai)
INSTANTLY_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Inngest — generate both with: openssl rand -hex 32
# (or: python -c "import secrets; print(secrets.token_hex(32))")
# Must be hex with an even number of characters. Use the same values in
# docker compose / the Inngest server. Local `npx inngest-cli dev` ignores these.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
# Self-hosted Inngest (skip these when using `npx inngest-cli dev`):
# INNGEST_DEV=0
# INNGEST_BASE_URL=http://localhost:8288

# Resend (https://resend.com) - for daily digest emails
RESEND_API_KEY=

# Daily digest email settings
DIGEST_FROM_EMAIL=autogtm <noreply@yourdomain.com>
DIGEST_RECIPIENTS=you@example.com

# Contact form (Request cloud access) - where to receive submissions
CONTACT_FORM_TO=

# Invite codes (comma-separated) - users need one of these to sign up
INVITE_CODES=AUTOGTM

# App URL (used in digest email links)
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Google OAuth (optional - get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Redis (optional - for rate limiting)
REDIS_URL=
