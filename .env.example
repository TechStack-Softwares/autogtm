# Copy to `.env` in the repo root, then `docker compose up --build`.
# NEXT_PUBLIC_* values are baked into the image at build time — rebuild after changing them.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3200
INVITE_CODES=AUTOGTM

# --- Supabase (Settings → API Keys) ---
# New projects issue publishable/secret keys (sb_publishable_... / sb_secret_...).
# Legacy JWT names (anon / service_role) still work. The app accepts both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Auth redirect: in Supabase → Authentication → URL Configuration set
# Site URL to NEXT_PUBLIC_APP_URL and add {NEXT_PUBLIC_APP_URL}/auth/callback
# to Redirect URLs.

# --- Inngest (self-hosted by docker compose) ---
# Generate both: openssl rand -hex 32
# or: python -c "import secrets; print(secrets.token_hex(32))"
# Must be hex with an even number of characters.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_DB_PASSWORD=inngest

# --- Third-party APIs (not self-hosted) ---
EXA_API_KEY=
INSTANTLY_API_KEY=
OPENAI_API_KEY=

# Resend (optional — daily digest emails)
RESEND_API_KEY=
DIGEST_FROM_EMAIL=autogtm <noreply@yourdomain.com>
DIGEST_RECIPIENTS=you@example.com

# Contact form (optional)
CONTACT_FORM_TO=

# Google OAuth (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
